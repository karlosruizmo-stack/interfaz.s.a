<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/profileScroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/x_black"
    android:fillViewport="true"
    android:clipToPadding="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Cabecera -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/header_height"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="@dimen/page_padding"
            android:paddingEnd="@dimen/page_padding">
            <TextView
                android:id="@+id/btnBack"
                android:layout_width="40dp"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="‹"
                android:textColor="@color/x_white"
                android:textSize="32sp"
                android:contentDescription="Volver" />
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingStart="8dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="X  ✓"
                    android:textColor="@color/x_white"
                    android:textSize="18sp"
                    android:textStyle="bold" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="14,9 mil publicaciones"
                    android:textColor="@color/x_muted"
                    android:textSize="12sp" />
            </LinearLayout>
            <TextView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:gravity="center"
                android:text="⋯"
                android:textColor="@color/x_white"
                android:textSize="24sp" />
        </LinearLayout>

        <!-- Portada y avatar -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/cover_height">
            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_cover" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="𝕏"
                android:textColor="@color/x_white"
                android:textSize="@dimen/cover_logo_size"
                android:textStyle="normal" />
            <TextView
                android:id="@+id/tvAvatar"
                android:layout_width="@dimen/avatar_size"
                android:layout_height="@dimen/avatar_size"
                android:layout_gravity="bottom|start"
                android:layout_marginStart="@dimen/page_padding"
                android:layout_marginBottom="-8dp"
                android:background="@drawable/bg_avatar"
                android:gravity="center"
                android:text="𝕏"
                android:textColor="@color/x_white"
                android:textSize="38sp" />
        </FrameLayout>

        <!-- Acciones de perfil -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="@dimen/page_padding"
            android:paddingTop="12dp"
            android:paddingEnd="@dimen/page_padding">
            <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />
            <TextView
                android:id="@+id/btnMore"
                style="@style/ProfileAction"
                android:text="⋯" />
            <TextView
                android:id="@+id/btnNotify"
                style="@style/ProfileAction"
                android:text="♧" />
            <TextView
                android:id="@+id/btnFollowing"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_following"
                android:gravity="center"
                android:minWidth="104dp"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:text="Siguiendo"
                android:textColor="@color/x_white"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Información -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/page_padding"
            android:paddingTop="12dp"
            android:paddingEnd="@dimen/page_padding"
            android:paddingBottom="14dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="X  ✓"
                android:textColor="@color/x_white"
                android:textSize="20sp"
                android:textStyle="bold" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@Twitter"
                android:textColor="@color/x_muted"
                android:textSize="14sp" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="What's happening?!"
                android:textColor="@color/x_white"
                android:textSize="14sp" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="◎  everywhere     ·  about.twitter.com\n▢  Se unió en febrero de 2007"
                android:textColor="@color/x_muted"
                android:textSize="12sp"
                android:lineSpacingExtra="3dp" />
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0 Siguiendo"
                    android:textColor="@color/x_white"
                    android:textSize="13sp"
                    android:textStyle="bold" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="18dp"
                    android:text="65,7 M Seguidores"
                    android:textColor="@color/x_white"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- Pestañas -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:fillViewport="true"
            android:scrollbars="none">
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:orientation="horizontal">
                <TextView style="@style/ProfileTabSelected" android:text="Publicaciones" />
                <TextView style="@style/ProfileTab" android:text="Afiliados" />
                <TextView style="@style/ProfileTab" android:text="Respuestas" />
                <TextView style="@style/ProfileTab" android:text="Destacados" />
                <TextView style="@style/ProfileTab" android:text="Multimedia" />
                <TextView style="@style/ProfileTab" android:text="Me gusta" />
            </LinearLayout>
        </HorizontalScrollView>
        <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/x_line" />

        <!-- Publicación -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="@dimen/page_padding"
            android:paddingTop="16dp"
            android:paddingEnd="@dimen/page_padding"
            android:paddingBottom="18dp">
            <TextView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:gravity="center"
                android:text="𝕏"
                android:textColor="@color/x_white"
                android:textSize="28sp" />
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingStart="10dp">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="X  ✓  @Twitter · 21 jul · ⋯"
                    android:textColor="@color/x_muted"
                    android:textSize="12sp" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:text="We've had tremendous interest in the new ads revenue sharing program from creators around the world.\n\nCreators who are eligible will automatically be able to start receiving ads revenue upon launch — all you need to do is set up payouts and you'll be good to go!"
                    android:textColor="@color/x_white"
                    android:textSize="14sp"
                    android:lineSpacingExtra="3dp" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="Ads revenue...  Mostrar más"
                    android:textColor="@color/x_blue"
                    android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>
        <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/x_line" />

        <!-- Navegación inferior -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="@color/x_black"
            android:gravity="center"
            android:orientation="horizontal">
            <TextView style="@style/BottomNavItem" android:text="⌂" />
            <TextView style="@style/BottomNavItem" android:text="⌕" />
            <TextView style="@style/BottomNavItem" android:text="♧" />
            <TextView style="@style/BottomNavItem" android:text="✉" />
            <TextView style="@style/BottomNavItem" android:text="●" />
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
